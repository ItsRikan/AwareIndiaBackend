{
    "installCommand": "pip install -r requirements.txt",
    "devCommand": "uvicorn src.api.index:app --host 0.0.0.0 --port $PORT",
    "outputDirectory": "src/api",
    "env": {
        "PYTHON_VERSION": "3.13"
    },
    "functions": {
        "api/index.py": {
            "memory": 2048,
            "maxDuration": 60
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api/index.py"
        }
    ]
}