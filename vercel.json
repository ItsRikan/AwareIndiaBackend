{
    "buildCommand": "pip install -r requirements.txt",
    "outputDirectory": "src/api",
    "env": {
        "PYTHON_VERSION": "3.13"
    },
    "functions": {
        "src/api/index.py": {
            "memory": 3008,
            "maxDuration": 60,
            "runtime": "python3.13"
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/src/api/index.py"
        }
    ]
}